{
  "name": "@otto/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./tenant": "./src/tenant.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file=../../.env src/migrate.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "bootstrap": "node --env-file=../../.env src/bootstrap.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@otto/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "@otto/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.11"
  }
}
