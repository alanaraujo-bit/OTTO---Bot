# Copie para .env e preencha. O arquivo .env nunca é versionado.
# Os valores de desenvolvimento saem do ambiente `development` do projeto Railway "otto".

APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ── Banco ────────────────────────────────────────────────────────────────────
# Papel da aplicação. Sujeito a RLS — é com este que o produto inteiro fala.
DATABASE_URL=postgresql://otto_app:SENHA@HOST:PORTA/railway
# Papel do backoffice do SaaS. Enxerga todas as empresas (BYPASSRLS).
DATABASE_PLATFORM_URL=postgresql://otto_platform:SENHA@HOST:PORTA/railway
# Papel administrativo. Só migrações; nunca atende requisição.
DATABASE_ADMIN_URL=postgresql://postgres:SENHA@HOST:PORTA/railway

# ── Fila e tempo real ────────────────────────────────────────────────────────
REDIS_URL=redis://default:SENHA@HOST:PORTA

# ── Segredos da aplicação ────────────────────────────────────────────────────
# Assina o cookie de sessão. 32+ caracteres. Trocar desconecta todo mundo.
SESSION_SECRET=
# Cifra tokens de canal em repouso (AES-256-GCM), 32 bytes em base64.
# Perder esta chave invalida as credenciais de canal já salvas.
ENCRYPTION_KEY=

# ── Provedores de IA ─────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Meta (WhatsApp / Instagram) ──────────────────────────────────────────────
# Preenchidos quando o app da Meta existir. Ver docs/META.md.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
